<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#F7F8F8"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivExerciseImg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/workout_1"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_chip_blue"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvExName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jumping Jacks"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_medium" />

            <TextView
                android:id="@+id/tvExDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="x20 · 3 sets · 30s"
                android:textSize="11sp"
                android:textColor="#ADA4A5"
                android:fontFamily="@font/poppins_regular" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnRemoveExercise"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/closed_btn"
            app:tint="#FF6B6B"
            android:padding="2dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
