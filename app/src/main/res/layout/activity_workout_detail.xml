<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 1. The Dynamic Blue Gradient Background -->
            <View
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:background="@drawable/bg_workout_header_gradient"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 2. The Glowing White Circle Ring -->
            <View
                android:layout_width="340dp"
                android:layout_height="340dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/bg_glow_circle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 3. Dynamic Header Image (Detail Top) -->
            <ImageView
                android:id="@+id/ivWorkoutImage"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@drawable/detail_top"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_workout_details_1"
                android:paddingTop="15dp"
                android:paddingBottom="100dp"
                android:layout_marginTop="300dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Drag Handle -->
                <View
                    android:layout_width="50dp"
                    android:layout_height="4dp"
                    android:background="#E2E2E2"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp"/>

                <!-- Title Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvWorkoutTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fullbody Workout"
                            android:textSize="18sp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_bold"/>
                        <TextView
                            android:id="@+id/tvWorkoutSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="11 Exercises | 32mins | 320 Calories Burn"
                            android:textSize="12sp"
                            android:textColor="#ADA4A5"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/fav"
                        android:background="@drawable/bg_circle_hollow_nav"
                        android:padding="8dp"/>
                </LinearLayout>

                <!-- Schedule Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F1F5FF"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/date"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Schedule Workout"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginStart="12dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5/27, 09:00 AM"
                            android:textColor="#ADA4A5"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginEnd="8dp"/>
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/arrow_right"
                            app:tint="#ADA4A5"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Difficulty Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F9F1FF"
                    android:layout_marginBottom="24dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/difficulity"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Difficulty"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginStart="12dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Beginner"
                            android:textColor="#ADA4A5"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginEnd="8dp"/>
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/arrow_right"
                            app:tint="#ADA4A5"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- You'll Need Section -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You'll Need"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 Items"
                        android:textSize="12sp"
                        android:textColor="#ADA4A5"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:layout_marginBottom="24dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <!-- Item 1 -->
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="start" android:layout_marginEnd="15dp">
                            <androidx.cardview.widget.CardView android:layout_width="100dp" android:layout_height="100dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="#F7F8F8">
                                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/barbell" android:padding="20dp" android:scaleType="centerInside"/>
                            </androidx.cardview.widget.CardView>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Barbell" android:textSize="12sp" android:textColor="@color/black" android:layout_marginTop="8dp" android:fontFamily="@font/poppins_medium"/>
                        </LinearLayout>
                        <!-- Item 2 -->
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="start" android:layout_marginEnd="15dp">
                            <androidx.cardview.widget.CardView android:layout_width="100dp" android:layout_height="100dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="#F7F8F8">
                                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/skipping_rope" android:padding="20dp" android:scaleType="centerInside"/>
                            </androidx.cardview.widget.CardView>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Skipping Rope" android:textSize="12sp" android:textColor="@color/black" android:layout_marginTop="8dp" android:fontFamily="@font/poppins_medium"/>
                        </LinearLayout>
                        <!-- Item 3 -->
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="start">
                            <androidx.cardview.widget.CardView android:layout_width="100dp" android:layout_height="100dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="#F7F8F8">
                                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/bottle" android:padding="20dp" android:scaleType="centerInside"/>
                            </androidx.cardview.widget.CardView>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bottle 1 Litre" android:textSize="12sp" android:textColor="@color/black" android:layout_marginTop="8dp" android:fontFamily="@font/poppins_medium"/>
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Exercises Section -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exercises"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 Sets"
                        android:textSize="12sp"
                        android:textColor="#ADA4A5"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                    
                <!-- Exercise Set 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp">
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Set 1" android:textSize="12sp" android:textColor="@color/black" android:fontFamily="@font/poppins_medium" android:layout_marginBottom="12dp"/>
                    
                    <!-- Exercise 1 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="15dp">
                        <androidx.cardview.widget.CardView android:layout_width="60dp" android:layout_height="60dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#F7F8F8">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/img_1" android:scaleType="centerCrop"/>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="15dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Warm Up" android:textSize="14sp" android:textColor="@color/black" android:fontFamily="@font/poppins_medium"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05:00" android:textSize="12sp" android:textColor="#ADA4A5" android:fontFamily="@font/poppins_regular"/>
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/arrow_right" app:tint="#ADA4A5" android:background="@drawable/bg_circle_hollow_nav" android:padding="6dp"/>
                    </LinearLayout>

                    <!-- Exercise 2 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="15dp">
                        <androidx.cardview.widget.CardView android:layout_width="60dp" android:layout_height="60dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#F7F8F8">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/img_2" android:scaleType="centerCrop"/>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="15dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jumping Jack" android:textSize="14sp" android:textColor="@color/black" android:fontFamily="@font/poppins_medium"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12x" android:textSize="12sp" android:textColor="#ADA4A5" android:fontFamily="@font/poppins_regular"/>
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/arrow_right" app:tint="#ADA4A5" android:background="@drawable/bg_circle_hollow_nav" android:padding="6dp"/>
                    </LinearLayout>
                    
                    <!-- Exercise 3 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="15dp">
                        <androidx.cardview.widget.CardView android:layout_width="60dp" android:layout_height="60dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#F7F8F8">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/img_1" android:scaleType="centerCrop"/>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="15dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Skipping" android:textSize="14sp" android:textColor="@color/black" android:fontFamily="@font/poppins_medium"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15x" android:textSize="12sp" android:textColor="#ADA4A5" android:fontFamily="@font/poppins_regular"/>
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/arrow_right" app:tint="#ADA4A5" android:background="@drawable/bg_circle_hollow_nav" android:padding="6dp"/>
                    </LinearLayout>

                    <!-- Exercise 4 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="15dp">
                        <androidx.cardview.widget.CardView android:layout_width="60dp" android:layout_height="60dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#F7F8F8">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/img_2" android:scaleType="centerCrop"/>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="15dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Squats" android:textSize="14sp" android:textColor="@color/black" android:fontFamily="@font/poppins_medium"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20x" android:textSize="12sp" android:textColor="#ADA4A5" android:fontFamily="@font/poppins_regular"/>
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/arrow_right" app:tint="#ADA4A5" android:background="@drawable/bg_circle_hollow_nav" android:padding="6dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Exercise Set 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginTop="10dp">
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Set 2" android:textSize="12sp" android:textColor="@color/black" android:fontFamily="@font/poppins_medium" android:layout_marginBottom="12dp"/>
                    
                    <!-- Exercise 1 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="15dp">
                        <androidx.cardview.widget.CardView android:layout_width="60dp" android:layout_height="60dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#F7F8F8">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/img_1" android:scaleType="centerCrop"/>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="15dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Incline Push-Ups" android:textSize="14sp" android:textColor="@color/black" android:fontFamily="@font/poppins_medium"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12x" android:textSize="12sp" android:textColor="#ADA4A5" android:fontFamily="@font/poppins_regular"/>
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/arrow_right" app:tint="#ADA4A5" android:background="@drawable/bg_circle_hollow_nav" android:padding="6dp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Header Operations overlayed -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/arrow_left"
        android:background="@drawable/bg_nav_back"
        android:padding="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnMore"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/menu_dots"
        android:background="@drawable/bg_nav_back"
        android:padding="8dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Start Workout Button fixed float at bottom -->
    <TextView
        android:id="@+id/btnStartWorkout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="30dp"
        android:text="Start Workout"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:background="@drawable/btn_gradient_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        android:elevation="6dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
