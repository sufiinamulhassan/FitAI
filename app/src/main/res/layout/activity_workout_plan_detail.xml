<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_left"
            android:background="@drawable/bg_nav_back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Workout Plan"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/clHeader"
        app:layout_constraintBottom_toTopOf="@id/btnStartPlan">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Plan Hero Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_blue_gradient"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_centerVertical="true">

                        <TextView
                            android:id="@+id/tvPlanTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full Body Workout"
                            android:textSize="20sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:id="@+id/tvPlanDesc"
                            android:layout_width="180dp"
                            android:layout_height="wrap_content"
                            android:text="30 Days Challenge"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_regular"
                            android:alpha="0.9"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvPlanCalories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥 320 Cal/session"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivPlanImage"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/workout_1"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:scaleType="fitCenter" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Progress Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Progress"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:id="@+id/tvProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="14sp"
                        android:textColor="#9DCEFF"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_drawable" />
            </LinearLayout>

            <!-- Difficulty Level Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Level"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/llLevelSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/btnLevelBeginner"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="Beginner"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:background="@drawable/bg_pill_button"
                    android:backgroundTint="#9DCEFF"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btnLevelIntermediate"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="Intermediate"
                    android:textSize="12sp"
                    android:textColor="#ADA4A5"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:background="@drawable/bg_pill_button"
                    android:backgroundTint="#F7F8F8"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btnLevelAdvanced"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="Advanced"
                    android:textSize="12sp"
                    android:textColor="#ADA4A5"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:background="@drawable/bg_pill_button"
                    android:backgroundTint="#F7F8F8" />
            </LinearLayout>

            <!-- Days Grid Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workout Days"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="12dp" />

            <!-- Days Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDaysGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="30dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Start Button -->
    <TextView
        android:id="@+id/btnStartPlan"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:text="Start Next Day"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_bold"
        android:background="@drawable/btn_gradient_bg"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
