<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="5dp">

    <!-- Step Number Text (e.g. "01") -->
    <TextView
        android:id="@+id/tvStepNumText"
        android:layout_width="25dp"
        android:layout_height="wrap_content"
        android:text="01"
        android:textColor="#ADA4A5"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginTop="0dp"/>

    <!-- Timeline graphics -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="15dp">

        <View
            android:id="@+id/vTimelineDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_timeline_dot_inactive"/>

        <View
            android:id="@+id/vTimelineLine"
            android:layout_width="1dp"
            android:layout_height="60dp"
            android:background="#F1F1F1"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"/>
    </LinearLayout>

    <!-- Step Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="15dp">

        <TextView
            android:id="@+id/tvStepTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium"/>

        <TextView
            android:id="@+id/tvStepDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step description details"
            android:textColor="#ADA4A5"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_regular"/>
    </LinearLayout>
</LinearLayout>
