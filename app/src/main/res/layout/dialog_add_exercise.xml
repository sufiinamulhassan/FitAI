<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Exercise Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exercise Name"
            android:textSize="13sp"
            android:textColor="#1D1617"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etExName"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. Jumping Jacks"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:fontFamily="@font/poppins_regular"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <!-- Reps & Sets Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reps"
                    android:textSize="13sp"
                    android:textColor="#1D1617"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etExReps"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input"
                    android:hint="x12"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:fontFamily="@font/poppins_regular"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sets"
                    android:textSize="13sp"
                    android:textColor="#1D1617"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etExSets"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input"
                    android:hint="3"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:fontFamily="@font/poppins_regular"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- Duration & Rest Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duration (sec)"
                    android:textSize="13sp"
                    android:textColor="#1D1617"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etExDuration"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input"
                    android:hint="30"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:fontFamily="@font/poppins_regular"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rest (sec)"
                    android:textSize="13sp"
                    android:textColor="#1D1617"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etExRest"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input"
                    android:hint="15"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:fontFamily="@font/poppins_regular"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- Instructions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instructions"
            android:textSize="13sp"
            android:textColor="#1D1617"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etExInstructions"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@drawable/bg_input"
            android:hint="How to do this exercise"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:gravity="top|start"
            android:fontFamily="@font/poppins_regular"
            android:inputType="textMultiLine" />

    </LinearLayout>
</ScrollView>
