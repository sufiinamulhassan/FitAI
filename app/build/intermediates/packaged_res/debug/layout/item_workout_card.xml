<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivWorkoutThumb"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:src="@drawable/workout_1"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_card_light_blue"
            android:padding="4dp"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWorkoutName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fullbody Workout"
                android:textSize="14sp"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/poppins_medium"/>

            <TextView
                android:id="@+id/tvWorkoutInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11 Exercises | 32mins | 320 Calories Burn"
                android:textSize="11sp"
                android:textColor="@color/text_medium"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginTop="3dp"/>

            <ProgressBar
                android:id="@+id/pbWorkoutProgress"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:progress="55"
                android:progressDrawable="@drawable/progress_drawable"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/next_go"
            android:scaleType="fitCenter"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>

