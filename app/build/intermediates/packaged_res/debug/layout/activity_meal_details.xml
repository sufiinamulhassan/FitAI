<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9DCEFF"> <!-- Theme background for the top part -->

    <!-- Top Tools -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        android:elevation="5dp">
        
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_left"
            android:background="@drawable/bg_nav_back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/menu_dots"
            android:background="@drawable/bg_nav_back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Food Image -->
    <ImageView
        android:id="@+id/ivFoodMain"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:src="@drawable/pancake_1"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toBottomOf="@id/clTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Content Card -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_rounded_top_white"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/ivFoodMain"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="30dp">

            <View android:layout_width="40dp" android:layout_height="5dp" android:background="#F1F1F1" android:layout_gravity="center_horizontal" android:layout_marginBottom="20dp"/>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp">
                <TextView
                    android:id="@+id/tvMealTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blueberry Pancake"
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_alignParentStart="true" />
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/fav"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:tint="#FF3E3E"/>
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="by James Ruth"
                android:textSize="12sp"
                android:textColor="#ADA4A5"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="25dp" />

            <!-- Nutrition Chips -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nutrition" android:textSize="16sp" android:textColor="@color/black" android:fontFamily="@font/poppins_bold" android:layout_marginBottom="15dp" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="20dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip_light" android:padding="10dp" android:gravity="center_vertical" android:layout_marginEnd="10dp">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/burn" app:tint="#FF9B9B"/>
                        <TextView android:id="@+id/tvMealCaloriesVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="180kCal" android:textSize="11sp" android:textColor="#ADA4A5" android:fontFamily="@font/poppins_regular" android:layout_marginStart="5dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip_light" android:padding="10dp" android:gravity="center_vertical" android:layout_marginEnd="10dp">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/water" app:tint="#9DCEFF"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30g fats" android:textSize="11sp" android:textColor="#ADA4A5" android:fontFamily="@font/poppins_regular" android:layout_marginStart="5dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip_light" android:padding="10dp" android:gravity="center_vertical" android:layout_marginEnd="10dp">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/foot" app:tint="#C58BF2"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20g proteins" android:textSize="11sp" android:textColor="#ADA4A5" android:fontFamily="@font/poppins_regular" android:layout_marginStart="5dp"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Descriptions" android:textSize="16sp" android:textColor="@color/black" android:fontFamily="@font/poppins_bold" android:layout_marginBottom="10dp" />
            <TextView
                android:id="@+id/tvMealDescVal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pancakes are some people's favorite breakfast..."
                android:textSize="12sp"
                android:textColor="#ADA4A5"
                android:fontFamily="@font/poppins_regular"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="25dp" />

            <!-- Ingredients -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ingredients That You\nWill Need" android:textSize="16sp" android:textColor="@color/black" android:fontFamily="@font/poppins_bold" />
                <TextView android:id="@+id/tvMealIngredientsVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6 items" android:textSize="12sp" android:textColor="#ADA4A5" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
            </RelativeLayout>
            
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="25dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <!-- Flour -->
                    <LinearLayout android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="15dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="80dp" android:src="@drawable/flour" android:background="@drawable/bg_chip_light" android:padding="20dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wheat Flour" android:textSize="11sp" android:textColor="@color/black" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100gr" android:textSize="10sp" android:textColor="#ADA4A5"/>
                    </LinearLayout>
                    <!-- Sugar -->
                    <LinearLayout android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="15dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="80dp" android:src="@drawable/sugar" android:background="@drawable/bg_chip_light" android:padding="20dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sugar" android:textSize="11sp" android:textColor="@color/black" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 tbsp" android:textSize="10sp" android:textColor="#ADA4A5"/>
                    </LinearLayout>
                    <!-- Soda -->
                    <LinearLayout android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="15dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="80dp" android:src="@drawable/baking_soda" android:background="@drawable/bg_chip_light" android:padding="20dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Baking Soda" android:textSize="11sp" android:textColor="@color/black" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 tsp" android:textSize="10sp" android:textColor="#ADA4A5"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Steps -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Step by Step" android:textSize="16sp" android:textColor="@color/black" android:fontFamily="@font/poppins_bold" />
                <TextView android:id="@+id/tvDetailsStepCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Steps" android:textSize="12sp" android:textColor="#ADA4A5" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:fontFamily="@font/poppins_regular"/>
            </RelativeLayout>

            <!-- Dynamic Steps Container -->
            <LinearLayout
                android:id="@+id/llDetailsStepsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- Spacer for the bottom button -->
            <View android:layout_width="match_parent" android:layout_height="80dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Button - Floating at absolute bottom -->
    <TextView
        android:id="@+id/btnAddMeal"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="Add to Breakfast Meal"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:background="@drawable/bg_pill_button"
        android:backgroundTint="#9DCEFF"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="10dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
