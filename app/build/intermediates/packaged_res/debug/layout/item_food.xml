<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/ivFoodImage" android:layout_width="55dp" android:layout_height="55dp" android:src="@drawable/pancake_1" android:scaleType="centerInside" android:layout_marginEnd="15dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvFoodName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Blueberry Pancake" android:textSize="14sp" android:textColor="@color/black" android:fontFamily="@font/poppins_medium"/>
            <TextView android:id="@+id/tvFoodCalories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medium | 30mins | 230kCal" android:textSize="12sp" android:textColor="#ADA4A5" android:fontFamily="@font/poppins_regular" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/arrow_right" android:background="@drawable/bg_circle_arrow" android:padding="8dp" android:scaleType="fitCenter" app:tint="#C58BF2"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
